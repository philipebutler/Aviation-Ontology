// System architecture domain only — PLM chain belongs in aircraft-product.dot
digraph aircraft {

    rankdir=BT

    graph [
        label="Aircraft — System Architecture Domain\nAviation Ontology · entity.aircraft v0.1.0"
        labelloc=t
        fontname="Helvetica Neue, Helvetica, Arial, sans-serif"
        fontsize=12
        bgcolor="white"
        nodesep=0.7
        ranksep=1.1
        pad=0.5
        splines=ortho
    ]

    node [
        fontname="Helvetica Neue, Helvetica, Arial, sans-serif"
        fontsize=11
        shape=box
        style="rounded,filled"
        penwidth=1.5
        margin="0.2,0.12"
    ]

    edge [
        fontname="Helvetica Neue, Helvetica, Arial, sans-serif"
        fontsize=10
    ]

    // ── Abstract parent ────────────────────────────────────────────────────
    System [
        label="System\n(entity.system)"
        fillcolor="#dce8f7"
        color="#3a5f8a"
        fontcolor="#1a3a60"
    ]

    // ── Focal node ─────────────────────────────────────────────────────────
    Aircraft [
        label="Aircraft\n(entity.aircraft)"
        fillcolor="#0d3d6e"
        color="#f0a500"
        fontcolor="white"
        penwidth=3.0
        fontsize=13
    ]

    // ── SE domain ──────────────────────────────────────────────────────────
    AircraftSystem [
        label="AircraftSystem\n(entity.aircraft_system)"
        fillcolor="#d8f0d8"
        color="#2d6a2d"
        fontcolor="#1a3e1a"
    ]

    Function [
        label="Function\n(entity.function)"
        fillcolor="#d8f0d8"
        color="#2d6a2d"
        fontcolor="#1a3e1a"
    ]

    Part [
        label="Part\n(entity.part)"
        fillcolor="#d8f0d8"
        color="#2d6a2d"
        fontcolor="#1a3e1a"
    ]

    Assembly [
        label="Assembly\n(entity.assembly)"
        fillcolor="#d8f0d8"
        color="#2d6a2d"
        fontcolor="#1a3e1a"
    ]

    // ── Requirements ───────────────────────────────────────────────────────
    Requirement [
        label="Requirement\n(entity.requirement)"
        fillcolor="#fce8c0"
        color="#c87800"
        fontcolor="#5a3000"
    ]

    // ── Edges ──────────────────────────────────────────────────────────────

    // IS-A
    Aircraft      -> System [ label="  specializes  "  style=dashed  arrowhead=empty  penwidth=2.0  color="#1a4f87"  fontcolor="#1a4f87" ]
    AircraftSystem -> System [ label="  specializes  "  style=dashed  arrowhead=empty  penwidth=1.8  color="#3a5f8a"  fontcolor="#3a5f8a" ]

    // System decomposition
    Aircraft       -> AircraftSystem [ label="  contains_system [1..*]  "  penwidth=2.0  color="#2d6a2d"  fontcolor="#2d6a2d" ]
    AircraftSystem -> AircraftSystem [ label="  contains_system [0..*]  "  penwidth=1.5  color="#2d6a2d"  fontcolor="#2d6a2d" ]

    // Function allocation
    Function -> AircraftSystem [ label="  allocated_to  "  penwidth=1.8  color="#2d6a2d"  fontcolor="#2d6a2d" ]

    // Physical realization — system decomposes to assemblies, sub-assemblies, then parts
    AircraftSystem -> Assembly [ label="  realized_by [1..*]  "  penwidth=1.8  color="#2d6a2d"  fontcolor="#2d6a2d" ]
    Assembly       -> Assembly [ label="  has_child [0..*]  "   penwidth=1.5  style=dashed  color="#2d6a2d"  fontcolor="#2d6a2d" ]
    Assembly       -> Part     [ label="  has_child [1..*]  "   penwidth=1.5  color="#2d6a2d"  fontcolor="#2d6a2d" ]

    // Requirements
    Requirement -> Aircraft  [ label="  applies_to  "  penwidth=2.0  color="#c87800"  fontcolor="#c87800" ]
    Function    -> Requirement [ label="  satisfies  "  penwidth=1.8  color="#c87800"  fontcolor="#c87800" ]

}